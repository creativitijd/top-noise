# Supabase → tandwiel (Project Settings) → API Keys
# Project URL: Connect-knop bovenaan, of Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Legacy API Keys → anon public  (of Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Legacy API Keys → service_role  (Reveal; alleen server)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

APP_URL=http://localhost:3000
CRON_SECRET=generate-a-long-random-string
APP_SECRET=generate-another-long-random-string

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_ANALYSIS_MODEL=gpt-4o
AI_IMAGE_MODEL=gpt-image-1

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/oauth/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/oauth/callback

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/callback

# Google Analytics + Search Console (alleen lezen). Consent-scherm: In production, niet Testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
